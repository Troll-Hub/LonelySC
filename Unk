 var features=[];
 if(/^\s*async\b/.test(src)||/\basync\s/.test(src.slice(0,60)))features.push(['async','g']);
 if(/^\s*function\s*\*/.test(src)||/\bfunction\s*\*/.test(src.slice(0,80)))features.push(['generador','g']);
 if(/^\s*class[\s{]/.test(src))features.push(['clase','g']);
 if(/=>/.test(src))features.push(['arrow','']);
 if(/\[native code\]/.test(src))features.push(['nativa','y']);
 if(/\bawait\b/.test(body))features.push(['usa await','y']);
 if(/\byield\b/.test(body))features.push(['usa yield','y']);
 if(/\bthis\b/.test(body))features.push(['usa this','']);
 if(/\breturn\b/.test(body))features.push(['retorna valor','g']);
 if(/\bthrow\b/.test(body))features.push(['lanza errores','r']);
 if(/\btry\b/.test(body))features.push(['try/catch','g']);
 if(/\bfor\b|\bwhile\b|\bdo\b/.test(body))features.push(['bucles','']);
 if(/\.(map|filter|reduce|forEach|some|every)\(/.test(body))features.push(['iteradores','']);
 if(/document\.|querySelector|getElementById|innerHTML/.test(body))features.push(['DOM','']);
 if(/fetch\(|XMLHttpRequest|axios|\.ajax\(/.test(body))features.push(['red','y']);
 if(/localStorage|sessionStorage|indexedDB|document\.cookie/.test(body))features.push(['almacenamiento','y']);
 if(/addEventListener|removeEventListener|onclick|dispatchEvent/.test(body))features.push(['eventos','']);
 if(/setTimeout|setInterval|requestAnimationFrame/.test(body))features.push(['temporizadores','y']);
 if(/new\s+Promise|\.then\(|async/.test(body))features.push(['asíncrona','y']);
 if(/eval\(|new Function/.test(body))features.push(['eval','r']);
 if(/innerHTML|outerHTML|insertAdjacentHTML/.test(body))features.push(['html dinámico','r']);
 if(/\.value\b|\.innerText|\.textContent/.test(body))features.push(['lee/escribe texto','']);

 var calls={};
 (body.match(/\b([A-Za-z_$][\w$]*)\s*\(/g)||[]).forEach(function(s){
  var n=s.replace(/\s*\($/,'');
  if(['if','for','while','switch','catch','function','return','typeof','new','do','else','with','of','in'].indexOf(n)>-1)return;
  calls[n]=(calls[n]||0)+1;
 });
 var callList=Object.keys(calls).sort(function(a,b){return calls[b]-calls[a]});

 var name=f.fn.name||f.label;
 var recursive=name&&new RegExp('\\b'+name.replace(/[$]/g,'\\$')+'\\s*\\(').test(body);

 out.push('<div class="h">Identidad</div>');
 out.push(kv('Nombre',esc(name||'(anónima)')));
 out.push(kv('Ruta global',esc(f.path)));
 out.push(kv('Tipo',isC?'clase (constructor)':nat?'nativa del navegador':/=>/.test(src)?'arrow function':'función clásica'));
 out.push(kv('Parámetros',(paramsOf(src).length||f.fn.length)+' — '+(paramsOf(src).join(', ')||'ninguno')));
 out.push(kv('Longitud declarada (length)',f.fn.length));
 out.push(kv('Devuelve Promise',/^\s*async\b/.test(src)||/\bnew\s+Promise\b/.test(body)?'sí (probable)':'no detectado'));
 if(recursive)out.push(kv('Recursiva','sí — se llama a sí misma'));

 out.push('<div class="h">Rasgos detectados</div>');
 out.push('<div>'+(features.length?features.map(function(x){return'<span class="tag '+(x[1]||'')+'">'+x[0]+'</span>'}).join(''):'<span class="tag">sin rasgos destacables</span>')+'</div>');

 out.push('<div class="h">Complejidad aproximada</div>');
 var lines=src.split('\n').length;
 var branches=(body.match(/\bif\b|\belse\b|\bcase\b|\?|\&\&|\|\|/g)||[]).length;
 var level=branches<5?'baja':branches<15?'media':branches<30?'alta':'muy alta';
 out.push(kv('Líneas de código',lines));
 out.push(kv('Puntos de decisión',branches));
 out.push(kv('Complejidad estimada','<b>'+level+'</b>'));

 if(callList.length){
  out.push('<div class="h">Funciones que invoca</div>');
  out.push('<div>'+callList.slice(0,30).map(function(n){return'<span class="tag">'+esc(n)+' ×'+calls[n]+'</span>'}).join('')+'</div>');
 }

 out.push('<div class="h">Interpretación</div>');
 var interp=[];
 if(nat)interp.push('Es una función <b>nativa</b> implementada por el motor del navegador: no puedes ver su código real y su rendimiento está optimizado en C++.');
 else if(isC)interp.push('Es una <b>clase</b>: se usa con <span class="mono">new</span> y sirve como plantilla para crear objetos con estado y métodos.');
 else if(/=>/.test(src))interp.push('Es una <b>arrow function</b>: no tiene su propio <span class="mono">this</span>, hereda el del contexto donde fue definida.');
 else interp.push('Es una <b>función</b> con su propio <span class="mono">this</span>, que depende de cómo se invoque.');
 if(/usa await/.test(features.map(function(x){return x[0]}).join(' '))||/^async/.test(src))interp.push('Es <b>asíncrona</b>: devuelve una Promise y puede pausar su ejecución en los <span class="mono">await</span>. Al depurarla verás el resultado en dos fases (llamada y resolución).');
 if(recursive)interp.push('Se <b>llama a sí misma</b>: cuidado con casos base ausentes, puede provocar desbordamiento de pila.');
 if(/\bthrow\b/.test(body))interp.push('Puede <b>lanzar errores</b>: envuélvela en try/catch si la llamas tú.');
 if(/DOM/.test(features.map(function(x){return x[0]}).join(' ')))interp.push('Toca el <b>DOM</b>: sus efectos se ven en la página, no solo en los valores devueltos.');
 if(/red/.test(features.map(function(x){return x[0]}).join(' ')))interp.push('Hace <b>peticiones de red</b>: revisa también la pestaña Network de DevTools.');
 if(!body.trim())interp.push('El cuerpo no es inspeccionable desde aquí.');
 out.push('<div style="color:#a9b6cc">'+interp.join('<br><br>')+'</div>');

 return out.join('');
}
function kv(k,v){return'<div class="kv"><b>'+k+'</b><span>'+v+'</span></div>'}

function renderDetail(){
 var f=state.sel;
 var code=$('code'),an=$('an'),help=$('help'),notes=$('notes');
 if(!f){
  var e='<div class="empty">Selecciona una función en la pestaña <b>Funciones</b> para inspeccionarla.<br><br>Pulsa ○ para activar la depuración y ✕ el marcador para salir.</div>';
  code.innerHTML=e;an.innerHTML=e;help.innerHTML=e;notes.innerHTML=e;return;
 }

 var src=srcOf(f.fn);
 code.innerHTML=
  '<div class="h">'+esc(f.path)+(f.wrapped?' <span class="tag g">depurando</span>':'')+'</div>'+
  '<div style="display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap">'+
   '<button class="btn '+(f.wrapped?'on':'p')+'" id="tgl">'+(f.wrapped?'Desactivar depuración':'Activar depuración')+'</button>'+
   '<button class="btn" id="cp">Copiar código</button>'+
   '<button class="btn" id="go">Ver en consola</button>'+
  '</div>'+
  '<pre class="code">'+esc(src)+'</pre>';

 an.innerHTML=analyze(f);

 var h=HELP[f.fn.name]||HELP[f.label];
 var native=isNative(f.fn);
 help.innerHTML=
  '<div class="h">Ayuda de esta función</div>'+
  (h?'<div class="kv"><b>Qué hace</b><span>'+h.d+'</span></div>':'')+
  (native?'<div class="kv"><b>Origen</b><span>Implementada por el navegador (código nativo).</span></div>':'<div class="kv"><b>Origen</b><span>Definida por la propia página.</span></div>')+
  '<div class="h">Recursos</div>'+
  '<div style="display:flex;gap:6px;flex-wrap:wrap">'+
   (h&&h.u?'<a class="btn" target="_blank" rel="noopener" href="'+h.u+'">Documentación MDN</a>':'')+
   '<a class="btn" target="_blank" rel="noopener" href="https://developer.mozilla.org/es/search?q='+encodeURIComponent(f.fn.name||f.label)+'">Buscar en MDN</a>'+
   '<a class="btn" target="_blank" rel="noopener" href="https://www.google.com/search?q='+encodeURIComponent((f.fn.name||f.label)+' javascript función')+'">Buscar en Google</a>'+
  '</div>'+
  '<div class="h">Cómo depurarla aquí</div>'+
  '<div style="color:#a9b6cc;line-height:1.8">1. Pulsa <b>Activar depuración</b> en la pestaña Código.<br>'+
  '2. Usa la página normalmente.<br>'+
  '3. Mira la pestaña <b>Logs</b>: verás cada llamada con sus argumentos, el valor devuelto, errores y duración.<br>'+
  '4. Activa <b>Consola: ON</b> abajo para volcar todo también a la consola real (objetos expandibles).<br>'+
  '5. Vuelve a pulsar el marcador o <b>Restaurar todo</b> para dejar la página intacta.</div>'+
  '<div class="h">Firma reconstruida</div>'+
  '<pre class="code">'+esc((f.fn.name||f.label)+'('+paramsOf(src).join(', ')+')')+'</pre>';

 notes.innerHTML=
  '<div class="h">Notas libres para esta función</div>'+
  '<div style="color:#7b879e;font-size:11.5px;margin-bottom:8px">Se guardan en este navegador (localStorage) asociadas al dominio actual.</div>'+
  '<textarea class="notes" id="nt" placeholder="Escribe aquí tu interpretación, hipótesis, pendientes…"></textarea>';
 var ta=$('nt');
 ta.value=state.notes[f.path]||'';
 ta.addEventListener('input',function(){
  state.notes[f.path]=ta.value;
  try{localStorage.setItem('__dbg_notes__',JSON.stringify(state.notes))}catch(e){}
 });

 var tgl=$('tgl');
 if(tgl)tgl.onclick=function(){
  if(f.wrapped)deactivate(f);
  else if(!activate(f))alert('No se pudo instrumentar '+f.path+'\n(propiedad no configurable o protegida)');
  renderList();renderDetail();
 };
 var cp=$('cp');
 if(cp)cp.onclick=function(){
  try{navigator.clipboard.writeText(src);cp.textContent='¡Copiado!'}catch(e){cp.textContent='No disponible'}
  setTimeout(function(){cp.textContent='Copiar código'},1200);
 };
 var go=$('go');
 if(go)go.onclick=function(){try{console.log('%c'+f.path,'color:#6ea8ff;font-weight:bold',f.fn)}catch(e){}};
}

function renderLogs(){
 var box=$('logs');
 var q=($('lq').value||'').toLowerCase();
 box.textContent='';
 var arr=state.logs.filter(function(l){return !q||l.path.toLowerCase().indexOf(q)>-1});
 if(!arr.length){box.innerHTML='<div class="empty">Sin registros todavía.<br>Activa la depuración de alguna función y usa la página.</div>';return}
 var frag=document.createDocumentFragment();
 for(var i=arr.length-1;i>=0&&i>arr.length-301;i--){
  var l=arr[i];
  var d=document.createElement('div');
  var cls=l.type==='error'?'err':l.type==='return'?'ret':l.type==='resolve'?'res':'call';
  d.className='log '+cls;
  var ic=l.type==='call'?'→':l.type==='error'?'✗':'✓';
  var t1='<div class="t1"><span class="fn">'+esc(l.path)+'</span><span class="du">'+(l.dur!=null?l.dur.toFixed(1)+' ms':'')+'</span></div>';
  var t2='';
  if(l.type==='call')t2='<div class="t2">'+esc(l.args.map(function(a){return preview(a)}).join(', '))+'</div>';
  else if(l.type==='return'||l.type==='resolve')t2='<div class="t2">↩ '+esc(preview(l.val))+'</div>';
  else t2='<div class="t2" style="color:#ff9aa5">'+esc(l.err&&l.err.message||String(l.err))+'</div>';
  var t3='<div class="t3">'+esc(
    l.type==='call'?'argumentos:\n'+l.args.map(function(a,i){return'  ['+i+'] '+preview(a,0)}).join('\n')
    :l.type==='error'?(l.err&&l.err.stack||String(l.err))
    :'valor devuelto:\n  '+preview(l.val,0)
  )+'</div>';
  d.innerHTML='<span class="ic">'+ic+'</span><div class="bd">'+t1+t2+t3+'</div>';
  d.onclick=function(){this.classList.toggle('open')};
  frag.appendChild(d);
 }
 box.appendChild(frag);
}

var activeTab='list';
function setTab(t){
 activeTab=t;
 Array.prototype.forEach.call(sh.querySelectorAll('.tab'),function(b){b.classList.toggle('on',b.dataset.t===t)});
 Array.prototype.forEach.call(sh.querySelectorAll('.pane'),function(p){p.classList.toggle('on',p.dataset.p===t)});
 if(t==='list')renderList();
 if(t==='logs')renderLogs();
}

$('tabs').addEventListener('click',function(e){
 var b=e.target.closest('.tab');if(b)setTab(b.dataset.t);
});
$('q').addEventListener('input',renderList);
$('lq').addEventListener('input',renderLogs);
$('deep').addEventListener('change',function(){state.deep=this.checked;state.fns=scan();renderList();updateCount()});
$('lclr').onclick=function(){state.logs=[];renderLogs()};
$('scan').onclick=function(){restoreAll();state.fns=scan();renderList();updateCount();renderDetail()};
$('rest').onclick=function(){restoreAll();renderList();renderDetail();console.log('Todas las funciones restauradas.')};
$('cons').onclick=function(){state.toConsole=!state.toConsole;this.textContent='Consola: '+(state.toConsole?'ON':'OFF');this.classList.toggle('on',state.toConsole)};
$('cls').onclick=function(){window.__DBG.destroy()};

function updateCount(){
 var on=state.fns.filter(function(f){return f.wrapped}).length;
 $('cnt').textContent=state.fns.length+(on?' · '+on+' activas':'');
}

$('min').onclick=function(){
 P.classList.toggle('min');
 this.textContent=P.classList.contains('min')?'▢':'—';
 if(!P.classList.contains('min'))renderList();
};

var drag=false,dx=0,dy=0,hdr=$('hdr');
hdr.addEventListener('pointerdown',function(e){
 if(e.target.closest('button'))return;
 if(P.classList.contains('min'))return;
 if(window.matchMedia('(max-width:640px)').matches)return;
 var r=P.getBoundingClientRect();
 P.style.left=r.left+'px';P.style.top=r.top+'px';P.style.right='auto';P.style.bottom='auto';
 drag=true;dx=e.clientX-r.left;dy=e.clientY-r.top;
 hdr.setPointerCapture(e.pointerId);
});
hdr.addEventListener('pointermove',function(e){
 if(!drag)return;
 var x=Math.max(4,Math.min(window.innerWidth-80,e.clientX-dx));
 var y=Math.max(4,Math.min(window.innerHeight-40,e.clientY-dy));
 P.style.left=x+'px';P.style.top=y+'px';
});
hdr.addEventListener('pointerup',function(){drag=false});

state.fns=scan();
renderList();renderDetail();updateCount();renderLogs();

window.__DBG={
 toggle:function(){if(P.classList.contains('min')){$('min').click()}else{sh.host.style.display=sh.host.style.display==='none'?'':'none'}},
 destroy:function(){restoreAll();HOST.remove();delete window.__DBG},
 restore:restoreAll,
 open:function(){HOST.style.display=''},
 close:function(){HOST.style.display='none'}
};

console.log('%c🐞 Depurador de funciones activo','color:#3ddc84;font-weight:bold','— '+state.fns.length+' funciones detectadas');
})();
